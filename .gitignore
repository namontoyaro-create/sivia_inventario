# Entorno virtual
.venv/

# Archivos temporales de Python
__pycache__/
*.py[cod]

# Caché de pruebas y cobertura
.pytest_cache/
.coverage
htmlcov/

# Variables de entorno y credenciales
.env
.env.*
!.env.example

# Configuración local de Poetry
poetry.toml

# Configuración local generada por Ultralytics
Ultralytics/

# Modelos descargados y resultados de pruebas de visión
modelos/*.pt
modelos/*.json
resultados/
runs/

# Copias de entrenamiento regenerables desde las anotaciones
datos/dataset_yolo*/
*.cache

# Base de datos local de la aplicación web
datos/sivia.db

# Fotografías cargadas localmente desde Inventario
datos/productos/

# Evidencias locales de las verificaciones
datos/evidencias/

# Temporales de pruebas, respaldos operativos y datasets generados localmente
.pytesttmp*/
.tmp_*/
datos/respaldos/
datos/entrenamiento/
